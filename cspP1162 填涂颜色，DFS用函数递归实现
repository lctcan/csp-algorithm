#include<stdio.h>                //DFS深度搜索一直向深度搜索直到符合条件返回，             
#define MAX 35
int n;
int net[MAX][MAX];  //初始格子
int visited[MAX][MAX] = {0};  // 标记访问
int dx[4] = {-1, 1, 0, 0};  //方向数组
int dy[4] = {0, 0, 1, -1};
void  dfs(int x, int y)
{
    if(x < 0 || x >= n || y < 0 || y >= n) return;
    if( net[x][y] == 1 || visited[x][y] == 1 ) return ;
    visited[x][y] = 1;
    for(int i = 0; i < 4; i++)
    {
        int nx = x + dx[i];
        int ny = y + dy[i];
        dfs(nx, ny);
    }
}
int main()
{
    scanf("%d", &n);
    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            scanf("%d", &net[i][j]);
        }
    }
    for(int i = 0; i < n; i++)
    {
        if(net[0][i] ==0 && visited[0][i] !=1 ) //上边界开始
            dfs(0, i);
        if(net[n-1][i] ==0 && visited[n-1][i] !=1 )  //下边界开始
            dfs(n-1, i);
        if(net[i][0] ==0 && visited[i][0] !=1 ) //左边界开始
            dfs(i, 0);
        if(net[i][n-1] ==0 && visited[i][n-1] !=1 ) //有边界开始
            dfs(i, n-1);
    }
    for(int i = 0; i < n; i++)
    {
        for(int j = 0; j < n; j++)
        {
            if(net[i][j] == 0 && visited[i][j] == 0)
            {
                printf("2 ");
            }
            else
            {
                printf("%d ", net[i][j]);
            }
        }
        printf("\n");
    }
    return 0;
}
